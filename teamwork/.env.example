# ReproJourney environment template. Copy to `.env` and fill in your keys.
# `.env` is git-ignored: never commit real credentials.

# --- LLM provider selection -------------------------------------------------
# openai | anthropic | offline
# Leave blank to auto-detect: OPENAI_API_KEY -> openai, ANTHROPIC_API_KEY ->
# anthropic, otherwise the deterministic offline policy model is used.
REPROJOURNEY_LLM_PROVIDER=

# Optional: override the default model for the selected provider
# REPROJOURNEY_LLM_MODEL=gpt-4o-mini
# REPROJOURNEY_LLM_TEMPERATURE=0.2
# REPROJOURNEY_LLM_TIMEOUT=60
# REPROJOURNEY_LLM_MAX_RETRIES=1
# REPROJOURNEY_LLM_BACKOFF=0.8

# --- Provider credentials (required for real LLM mode) ----------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional OpenAI-compatible gateway
# OPENAI_BASE_URL=

# --- Agent runtime ----------------------------------------------------------
# REPROJOURNEY_MAX_REACT_STEPS=8
# REPROJOURNEY_TOOL_TIMEOUT=20
# REPROJOURNEY_RUN_DIR=runs
# REPROJOURNEY_PERSIST_SESSIONS=true
# REPROJOURNEY_GOVERNANCE_GATE=true
